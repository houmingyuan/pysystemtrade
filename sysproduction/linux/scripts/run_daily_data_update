#!/bin/zsh
# systrade 每日数据更新
#
# 数据源约定，详见 docs/data_principles_cn.md：
#   * 历史价格来自 Norgate，已一次性回填完成，因此本脚本不再走 barchart
#   * 每日增量统一从 IB 取：期货合约价格 + 汇率
#   * 一个品种只有一个价格来源，所以本脚本不引入第二个来源
#
# 步骤：
#   1. 等外置卷挂载
#   2. 采样合约             sysproduction.run_daily_contract_sampling
#      （IB 价格更新依赖采样合约表；表为空时 update_historical_prices 会空转且退出码为 0）
#   3. IB 期货合约价格      sysproduction.update_historical_prices
#   4. multiple prices      sysinit/henrik/update_multiple_prices_tolerant.py
#   5. adjusted prices      sysinit/henrik/update_adjusted_prices_tolerant.py
#   6. IB 汇率              sysinit/henrik/spotfx_from_ib_to_db.py
#      （spot FX 行情权限属于实盘账户，使用 private_config.yaml 顶层 fx_data）
#   7. 数据面校验           sysinit/henrik/check_daily_data_update.py
#      （步骤 exit 0 不代表数据推进了：尖峰被拒 / 采样表为空 / multiple 没跟上）
#
# 用法：
#   run_daily_data_update                  # 全部步骤
#   run_daily_data_update --skip-futures   # 只更新汇率
#   run_daily_data_update --skip-fx        # 只更新期货链路
#
# 环境变量：
#   DATA_CHECK_MAX_SPIKES   数据面校验允许的被拒合约数（默认 0，即任何被拒都算异常）
#                           正常日应为 0；如尖峰噪声太多可临时放宽
#   DATA_CHECK_MAX_STALE_DAYS  multiple prices 允许落后合约价格的天数（默认 7）
#
# 由 ~/Library/LaunchAgents/com.henrik.systrade.update.plist 调度，
# 每日 08:00 运行。全部路径写绝对路径，不依赖 PATH / ~ 软链接 / conda activate。

set -u

# ---------- 固定路径 ----------
PY=/Users/henrik/miniconda3/envs/invest/bin/python
PST_DIR=/Users/henrik/dev/pysystemtrade
DATA_ROOT=/Volumes/data/systrade
LOG_DIR=$DATA_ROOT/log
LOG_FILE=$LOG_DIR/update_$(date +%Y%m%d).log
VOLUME_WAIT_SECS=1800          # 等待外置卷挂载的最长时间（秒）
VOLUME_CHECK_INTERVAL=30

# ---------- 默认开关 ----------
UPDATE_FUTURES=true
UPDATE_FX=true

# ---------- IB 端口（前置检查用，见 FIR-219） ----------
IB_PORT_FUTURES=4002           # 纸面：期货合约价格
IB_PORT_FX=4001                # 实盘：spot FX 行情

port_listening() {
    lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

# ---------- 数据面校验阈值 ----------
DATA_CHECK_MAX_SPIKES=${DATA_CHECK_MAX_SPIKES:-0}
DATA_CHECK_MAX_STALE_DAYS=${DATA_CHECK_MAX_STALE_DAYS:-7}

# ---------- 日志（卷未挂载前只输出到终端，launchd 会收进本地日志） ----------
log() {
    local level=$1
    local message=$2
    local timestamp=$(date "+%Y-%m-%d %H:%M:%S")
    if [ -d "$LOG_DIR" ]; then
        echo "[$timestamp] [$level] $message" | tee -a "$LOG_FILE"
    else
        echo "[$timestamp] [$level] $message"
    fi
}

# ---------- 中断可追溯 ----------
trap 'log "ERROR" "脚本被外部终止 (term/int/hup)，中断于上述最后一条日志之后"; exit 143' TERM INT HUP
trap 'rc=$?; log "INFO" "脚本退出，退出码 $rc"' EXIT

show_help() {
    local exit_code=${1:-0}
    echo "Usage: $0 [options]"
    echo "Options:"
    echo "  -f, --skip-futures     Skip updating futures data"
    echo "  -x, --skip-fx          Skip updating forex data"
    echo "  -h, --help             Show this help message"
    exit "$exit_code"
}

# ---------- 参数解析 ----------
while [[ $# -gt 0 ]]; do
    case $1 in
        -f|--skip-futures) UPDATE_FUTURES=false; shift ;;
        -x|--skip-fx)      UPDATE_FX=false;      shift ;;
        -h|--help)         show_help 0 ;;
        *)
            log "ERROR" "Unknown option: $1"
            show_help 1
            ;;
    esac
done

# ---------- 前置检查 ----------
if [ ! -x "$PY" ]; then
    log "ERROR" "Python 解释器不存在: $PY"
    exit 1
fi
if [ ! -d "$PST_DIR" ]; then
    log "ERROR" "找不到仓库目录: $PST_DIR"
    exit 1
fi

waited=0
while [ ! -d "$DATA_ROOT/parquet" ]; do
    if [ $waited -ge $VOLUME_WAIT_SECS ]; then
        log "ERROR" "外置卷未挂载（$DATA_ROOT/parquet 不存在），已等待 ${VOLUME_WAIT_SECS}s，放弃"
        exit 1
    fi
    [ $waited -eq 0 ] && echo "[$(date '+%Y-%m-%d %H:%M:%S')] [WARN] 等待外置卷挂载: $DATA_ROOT"
    sleep $VOLUME_CHECK_INTERVAL
    waited=$((waited + VOLUME_CHECK_INTERVAL))
done

mkdir -p "$LOG_DIR"
cd "$PST_DIR" || exit 1
log "INFO" "Starting update process"

# ---------- 步骤执行：单个步骤失败不阻断后续步骤，最后统一汇总 ----------
FAILED_STEPS=()

run_step() {
    local name=$1
    shift
    log "INFO" ">>> $name"
    if "$@" >> "$LOG_FILE" 2>&1; then
        log "INFO" "$name 完成"
    else
        local rc=$?
        log "ERROR" "$name 失败（退出码 $rc）"
        FAILED_STEPS+=("$name")
    fi
}

# ---------- 期货链路：IB 合约价格 -> multiple -> adjusted ----------
if [ "$UPDATE_FUTURES" = true ]; then
    # IB Gateway 未启动/未登录时，上游各环节会各自报错（采样表为空、价格空转、退出码却可能是 0），
    # 历史上（2026-10-01~10-06）就是这样静默停摆的。这里做一次显式前置检查。
    if ! port_listening "$IB_PORT_FUTURES"; then
        log "ERROR" "IB 期货 API 端口 $IB_PORT_FUTURES 未监听（Gateway 未启动或未登录），跳过期货链路"
        exit 2
    fi
    run_step "采样合约" "$PY" -u -m sysproduction.run_daily_contract_sampling
    # 中断补数（FIR-219）：上一次数据距今 >2 天时，等效日变化可能超过常态尖峰阈值，
    # 临时放宽到 8*sqrt(间隔天数)，仅本次运行生效（cleaner 读 PYSYS_MAX_PRICE_SPIKE）。
    LAST_PRICE_DATE=$("$PY" - <<'PYEOF' 2>/dev/null || echo ""
import pandas as pd
path = "/Users/henrik/data/parquet/futures_adjusted_prices/CORN.parquet"
print(pd.read_parquet(path).index[-1].date())
PYEOF
)
    if [ -n "$LAST_PRICE_DATE" ]; then
        GAP_DAYS=$("$PY" - "$LAST_PRICE_DATE" <<'PYEOF' 2>/dev/null || echo "0"
import sys, pandas as pd
last = pd.Timestamp(sys.argv[1])
print(max(0, (pd.Timestamp.today().normalize() - last).days))
PYEOF
)
        if [ "${GAP_DAYS:-0}" -gt 2 ]; then
            export PYSYS_MAX_PRICE_SPIKE=$("$PY" - "$GAP_DAYS" <<'PYEOF'
import sys, math
gap = max(1, int(sys.argv[1]))
print(round(8.0 * math.sqrt(gap), 1))
PYEOF
)
            log "WARN" "检测到数据缺口 ${GAP_DAYS} 天，本次价格更新临时放宽尖峰阈值至 ${PYSYS_MAX_PRICE_SPIKE}"
        fi
    fi
    run_step "IB 期货合约价格" "$PY" -u -m sysproduction.update_historical_prices
    # 容错版：逐品种 try/except，单品种失败不中断整轮（上游版本会整体中止）
    run_step "multiple prices" "$PY" -u "$PST_DIR/sysinit/henrik/update_multiple_prices_tolerant.py" --allow-failures
    run_step "adjusted prices" "$PY" -u "$PST_DIR/sysinit/henrik/update_adjusted_prices_tolerant.py" --allow-failures
    # 失滚品种自动重建（FIR-219/220）：前端合约到期后换月日历未滚动会让 multiple prices 停住，
    # 这里按「合约价格新、链条落后」自动重建日历 + multiple + adjusted。
    run_step "失滚品种重建" "$PY" -u "$PST_DIR/sysinit/henrik/rebuild_stalled_instruments.py"
fi

# ---------- 汇率：IB ----------
if [ "$UPDATE_FX" = true ]; then
    # spot FX 行情权限属于实盘账户（FIR-158 实测），所以使用读取顶层 fx_data 的本地脚本
    if ! port_listening "$IB_PORT_FX"; then
        log "ERROR" "IB 实盘 API 端口 $IB_PORT_FX 未监听（Gateway 未启动或未登录），跳过汇率链路"
        FAILED_STEPS+=("IB 汇率(端口未监听)")
    else
    run_step "IB 汇率" "$PY" -u "$PST_DIR/sysinit/henrik/spotfx_from_ib_to_db.py"
    fi
fi

# ---------- 数据面校验：数据真的推进了吗 ----------
run_step "数据面校验" "$PY" -u "$PST_DIR/sysinit/henrik/check_daily_data_update.py" \
    --log "$LOG_FILE" \
    --max-spikes "$DATA_CHECK_MAX_SPIKES" \
    --max-stale-days "$DATA_CHECK_MAX_STALE_DAYS"

# ---------- 汇总 ----------
if [ ${#FAILED_STEPS[@]} -eq 0 ]; then
    log "INFO" "Update process completed successfully"
    exit 0
else
    log "ERROR" "Update process finished with failures: ${FAILED_STEPS[*]}"
    exit 1
fi
